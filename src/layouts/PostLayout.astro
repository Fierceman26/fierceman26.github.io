---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';
import type { CollectionEntry } from 'astro:content';
import { SITE, slugifyTag, findCategory } from '~/consts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const category = data.category ? findCategory(data.category) : null;

// 拿到原始 markdown 内容用于估算阅读时间
const rawBody = post.body ?? '';
const stats = readingTime(rawBody);
const readMinutes = Math.max(1, Math.round(stats.minutes));
const rightsYear = data.pubDate.getFullYear();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// 上一篇 / 下一篇 —— 按发布时间倒序
const all = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? all[idx - 1] : null;     // 比当前更新（更新的一篇）
const next = idx < all.length - 1 ? all[idx + 1] : null; // 比当前更老
---

<BaseLayout
  title={data.title}
  description={data.description}
  pageType="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
>
  <div class="reading-progress" id="reading-progress"></div>

  <article>
    <header class="post-header container">
      {category && (
        <div class="post-header__category">
          <a href={`/categories/${category.slug}/`}>{category.title} · {category.subtitle}</a>
        </div>
      )}
      <h1 class="post-header__title">{data.title}</h1>
      <p class="post-header__lead">{data.description}</p>
      <div class="post-header__meta">
        <FormattedDate date={data.pubDate} />
        <span class="sep" aria-hidden="true"></span>
        <span>{readMinutes} min read</span>
        {data.updatedDate && (
          <>
            <span class="sep" aria-hidden="true"></span>
            <span>Revised <FormattedDate date={data.updatedDate} /></span>
          </>
        )}
      </div>
    </header>

    <div class="prose-container">
      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        {data.tags.length > 0 && (
          <div class="post-tags" aria-label="标签">
            {data.tags.map((tag) => (
              <a class="tag-pill" href={`/tags/${slugifyTag(tag)}/`}>
                #{tag}
              </a>
            ))}
          </div>
        )}

        <p class="post-rights">
          &copy; {rightsYear} {SITE.author}. All rights reserved.
          Original: <a href={canonicalURL}>{canonicalURL}</a>
        </p>

        {(prev || next) && (
          <nav class="post-nav" aria-label="文章导航">
            {next ? (
              <div class="post-nav__cell">
                <span class="post-nav__label">← Older</span>
                <a class="post-nav__title" href={`/posts/${next.id}/`}>{next.data.title}</a>
              </div>
            ) : <div></div>}
            {prev ? (
              <div class="post-nav__cell is-next">
                <span class="post-nav__label">Newer →</span>
                <a class="post-nav__title" href={`/posts/${prev.id}/`}>{prev.data.title}</a>
              </div>
            ) : <div></div>}
          </nav>
        )}
      </footer>
    </div>
  </article>

  <script>
    // 阅读进度条
    const bar = document.getElementById('reading-progress');
    if (bar) {
      const update = () => {
        const scroll = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? (scroll / height) * 100 : 0;
        bar.style.width = `${pct}%`;
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>
</BaseLayout>
