---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import Comments from '~/components/Comments.astro';
import readingTime from 'reading-time';
import { SITE, slugifyTag, findCategory } from '~/consts';
import { localizePath, useLocale } from '~/i18n/routing';
import { categoryView, readTime, useUI } from '~/i18n/ui';
import { loadPosts, type JournalPost } from '~/lib/posts';

interface Props {
  post: JournalPost;
}

const locale = useLocale(Astro.currentLocale, Astro.url.pathname);
const t = useUI(locale);
const { post } = Astro.props;
const { data } = post;
const category = data.category ? findCategory(data.category) : null;
const categoryText = category ? categoryView(category, locale) : null;

const rawBody = post.body ?? '';
const stats = readingTime(rawBody);
const readMinutes = Math.max(1, Math.round(stats.minutes));
const rightsYear = data.pubDate.getFullYear();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const all = await loadPosts(locale);
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx < all.length - 1 ? all[idx + 1] : null;
---

<BaseLayout
  title={data.title}
  description={data.description}
  pageType="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
>
  <div class="reading-progress" id="reading-progress"></div>

  <article>
    <header class="post-header container">
      {category && categoryText && (
        <div class="post-header__category">
          <a href={localizePath(`/categories/${category.slug}/`, locale)}>{categoryText.title} · {categoryText.subtitle}</a>
        </div>
      )}
      <h1 class="post-header__title">{data.title}</h1>
      <p class="post-header__lead">{data.description}</p>
      <div class="post-header__meta">
        <FormattedDate date={data.pubDate} />
        <span class="sep" aria-hidden="true"></span>
        <span>{readTime(readMinutes, locale)}</span>
        {data.updatedDate && (
          <>
            <span class="sep" aria-hidden="true"></span>
            <span>{t.post.revised} <FormattedDate date={data.updatedDate} /></span>
          </>
        )}
      </div>
    </header>

    <div class="prose-container">
      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        {data.tags.length > 0 && (
          <div class="post-tags" aria-label={t.post.tagsAria}>
            {data.tags.map((tag) => (
              <a class="tag-pill" href={localizePath(`/tags/${slugifyTag(tag)}/`, locale)}>
                #{tag}
              </a>
            ))}
          </div>
        )}

        <p class="post-rights">
          &copy; {rightsYear} {SITE.author}. {t.rights}
          {t.post.original}: <a href={canonicalURL}>{canonicalURL}</a>
        </p>

        {(newer || older) && (
          <nav class="post-nav" aria-label={t.post.navAria}>
            {older ? (
              <div class="post-nav__cell">
                <span class="post-nav__label">{t.post.older}</span>
                <a class="post-nav__title" href={localizePath(`/posts/${older.id}/`, locale)}>{older.data.title}</a>
              </div>
            ) : <div></div>}
            {newer ? (
              <div class="post-nav__cell is-next">
                <span class="post-nav__label">{t.post.newer}</span>
                <a class="post-nav__title" href={localizePath(`/posts/${newer.id}/`, locale)}>{newer.data.title}</a>
              </div>
            ) : <div></div>}
          </nav>
        )}
      </footer>

      <Comments />
    </div>
  </article>

  <script>
    const bar = document.getElementById('reading-progress');
    if (bar) {
      const update = () => {
        const scroll = window.scrollY;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const pct = height > 0 ? (scroll / height) * 100 : 0;
        bar.style.width = `${pct}%`;
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>
</BaseLayout>
