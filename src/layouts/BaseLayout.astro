---
import { SITE } from '~/consts';
import { TAG_SLUG_ALT, alternatePath, localizePath, useLocale } from '~/i18n/routing';
import { useUI } from '~/i18n/ui';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  pageType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const locale = useLocale(Astro.currentLocale, Astro.url.pathname);
const t = useUI(locale);

const {
  title,
  description = t.metaDescription,
  image,
  noIndex = false,
  pageType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : null;
const zhURL = new URL(alternatePath(Astro.url.pathname, 'zh'), Astro.site).href;
const enURL = new URL(alternatePath(Astro.url.pathname, 'en'), Astro.site).href;
const rssHref = localizePath('/rss.xml', locale);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <!--
      语言偏好。未选择过时按 navigator.language 跳一次（zh* 留在中文，其余去 /en/）。
      点击「中 / EN」之后写入 locale-preference，此后只服从这个值，不再看浏览器语言。
      规则与 src/i18n/routing.ts 的 alternatePath 一致，标签 slug 用同一张对照表。
    -->
    <script is:inline define:vars={{ tagMap: TAG_SLUG_ALT, storageKey: 'locale-preference' }}>
      (function () {
        try {
          var path = location.pathname || '/';
          var isEn = path === '/en' || path.indexOf('/en/') === 0;
          var stored = null;
          try { stored = localStorage.getItem(storageKey); } catch (err) { stored = null; }
          var target;
          if (stored === 'en' || stored === 'zh') {
            target = stored;
          } else {
            var lang = (navigator.language || '').toLowerCase();
            target = lang.indexOf('zh') === 0 ? 'zh' : 'en';
          }
          var current = isEn ? 'en' : 'zh';
          if (target === current) return;

          var bare = path;
          if (path === '/en' || path === '/en/') bare = '/';
          else if (path.indexOf('/en/') === 0) bare = path.slice(3);

          var tag = bare.match(/^\/tags\/([^/]+)\/?$/);
          if (tag) {
            var slug = tag[1];
            try { slug = decodeURIComponent(slug); } catch (err) { /* keep */ }
            var mapped = tagMap[slug];
            if (mapped) bare = '/tags/' + encodeURIComponent(mapped) + '/';
          }

          function finish(p) {
            if (!p) p = '/';
            if (p.charAt(0) !== '/') p = '/' + p;
            var file = /\.[a-z0-9]+$/i.test(p);
            if (!file && p !== '/' && p.charAt(p.length - 1) !== '/') p += '/';
            return p;
          }

          bare = finish(bare);
          var next = target === 'zh' ? bare : (bare === '/' ? '/en/' : '/en' + bare);
          if (next !== path) location.replace(next + location.search + location.hash);
        } catch (err) { /* ignore */ }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="zh-CN" href={zhURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={zhURL} />
    {noIndex && <meta name="robots" content="noindex, follow" />}

    {/* 主题色（移动 Safari 顶栏）。清单里的 theme_color 是 Bordeaux，阅读时顶栏跟纸色。 */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1013" />

    {/*
      主屏幕 Web App。start_url 是 /，scope 是 /，中文无前缀、英文 /en/ 都留在独立窗口里。
      语言仍由下面的 locale-preference 脚本决定，不在清单里写死。
    */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.shortTitle} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* RSS：当前语言为主，另一种语言也挂上 */}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} hreflang={t.htmlLang} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} (中文)`} href="/rss.xml" hreflang="zh-CN" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} (English)`} href="/en/rss.xml" hreflang="en" />

    {/* Favicon */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* FOUC 防护：在样式加载前就尝试应用 data-theme，并让顶栏跟着纸色 */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme-preference');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
          var dark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          var meta = document.createElement('meta');
          meta.setAttribute('name', 'theme-color');
          meta.setAttribute('data-theme-color', 'active');
          meta.setAttribute('content', dark ? '#0f1013' : '#fafaf6');
          document.head.appendChild(meta);
        } catch (_) { /* ignore */ }
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var standalone = window.navigator.standalone === true
          || (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches);
        if (standalone) {
          document.documentElement.setAttribute('data-standalone', '');
          document.addEventListener('click', function (event) {
            if (event.defaultPrevented || event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            var link = event.target && event.target.closest ? event.target.closest('a[href]') : null;
            if (!link || link.hasAttribute('download')) return;
            var url;
            try { url = new URL(link.href, location.href); } catch (err) { return; }
            if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
            if (url.origin !== location.origin) return;
            if (url.pathname === location.pathname && url.search === location.search) return;
            event.preventDefault();
            location.href = url.href;
          }, true);
        }

        if (!('serviceWorker' in navigator)) return;
        var didWarm = false;
        var warm = function () {
          var urls = [location.href];
          var images = document.images || [];
          for (var i = 0; i < images.length; i++) {
            var src = images[i].currentSrc || images[i].src;
            if (!src) continue;
            try {
              var parsed = new URL(src, location.href);
              if (parsed.origin === location.origin) urls.push(parsed.href);
            } catch (err) { /* ignore */ }
          }
          urls.forEach(function (href) { fetch(href).catch(function () {}); });
        };
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).then(function () {
            if (navigator.serviceWorker.controller) warm();
          }).catch(function () {});
        });
        navigator.serviceWorker.addEventListener('controllerchange', function () {
          if (didWarm) return;
          didWarm = true;
          warm();
        });
      })();
    </script>
  </body>
</html>
