---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeaturedPost from '~/components/FeaturedPost.astro';
import PostCard from '~/components/PostCard.astro';
import { SITE, issueLabel, CATEGORIES } from '~/consts';
import { localizePath, useLocale } from '~/i18n/routing';
import { categoryView, entryLabel, readTime, useUI } from '~/i18n/ui';
import { loadPosts } from '~/lib/posts';
import readingTime from 'reading-time';

const locale = useLocale(Astro.currentLocale, Astro.url.pathname);
const t = useUI(locale);
const allPosts = await loadPosts(locale);
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const restPosts = allPosts.filter((p) => p.id !== featured?.id);
const featuredMinutes = featured
  ? Math.max(1, Math.round(readingTime(featured.body ?? '').minutes))
  : 0;
const featuredReadingTime = featured ? readTime(featuredMinutes, locale) : undefined;

const sectionCounts = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.category) {
    sectionCounts.set(post.data.category, (sectionCounts.get(post.data.category) ?? 0) + 1);
  }
}

const issue = issueLabel(new Date());
---

<BaseLayout description={t.metaDescription}>
  <section class="container hero">
    <div class="hero__masthead">
      <span>{issue}</span>
      <span style="color: var(--ink);">·</span>
      <span>{t.journalName}</span>
    </div>
    {locale === 'zh' ? (
      <h1 class="hero__title">
        关于信号完整性、<br />
        硅光，以及 EDA 里<br />
        那些<em>安静的细节</em>。
      </h1>
    ) : (
      <h1 class="hero__title">
        Notes on signal integrity,<br />
        silicon photonics, and the<br />
        <em>quiet details</em> of EDA.
      </h1>
    )}
    <p class="hero__lead">{locale === 'zh' ? SITE.taglineZh : SITE.tagline}</p>
  </section>

  {featured && (
    <FeaturedPost post={featured} readingTime={featuredReadingTime} />
  )}

  <section class="container">
    <div class="section-label">
      <span>{t.home.sections}</span>
    </div>
    <div class="sections-grid">
      {CATEGORIES.map((cat, i) => {
        const text = categoryView(cat, locale);
        const n = sectionCounts.get(cat.slug) ?? 0;
        return (
          <a class="section-card" href={localizePath(`/categories/${cat.slug}/`, locale)}>
            <div class="section-card__numeral" aria-hidden="true">
              S{String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="section-card__title">{text.title}</h3>
            <div class="section-card__subtitle">{text.subtitle}</div>
            <p class="section-card__tagline">{text.tagline}</p>
            <div class="section-card__keywords">
              {text.keywords.slice(0, 4).map((k) => <span>{k}</span>)}
            </div>
            <div class="section-card__footer">
              <span>{entryLabel(n, locale)}</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  {restPosts.length > 0 && (
    <section class="container">
      <div class="section-label">
        <span>{t.home.recent}</span>
      </div>
      <div class="grid">
        {restPosts.slice(0, 9).map((post, i) => (
          <PostCard post={post} index={i} />
        ))}
      </div>
      {restPosts.length > 9 && (
        <p style="text-align: center; margin-top: 3rem;">
          <a href={localizePath('/posts/', locale)} class="card__footer" style="display: inline-block;">
            {t.home.archive}<span aria-hidden="true">→</span>
          </a>
        </p>
      )}
    </section>
  )}

  {allPosts.length === 0 && (
    <section class="container" style="padding-block: 4rem; text-align: center;">
      <p class="meta">{t.home.empty}</p>
    </section>
  )}
</BaseLayout>
