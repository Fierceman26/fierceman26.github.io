---
import '~/styles/siph-widgets.css';
import { siphCopy } from './copy';
import { useLocale } from '~/i18n/routing';

const c = siphCopy(useLocale(Astro.currentLocale, Astro.url.pathname));
---

<figure class="siph-widget" data-siph="travel" aria-label={c.travel.aria}>
  <div class="siph-widget__accent" aria-hidden="true"></div>
  <div class="siph-widget__head">
    <p class="siph-widget__kicker">{c.schematic}</p>
    <p class="siph-widget__title">{c.travel.title}</p>
  </div>
  <div class="siph-widget__controls">
    <div class="siph-widget__seg" role="group" aria-label={c.travel.choose}>
      <button type="button" data-mode="te" aria-pressed="true">TE0</button>
      <button type="button" data-mode="tm" aria-pressed="false">TM0</button>
    </div>
    <button class="siph-widget__play" type="button" data-compare aria-pressed="true">{c.travel.compare}</button>
    <button class="siph-widget__play" type="button" data-play aria-pressed="false">{c.play}</button>
    <label class="siph-widget__slider">
      <span>{c.travel.time}</span>
      <input type="range" data-phase min="0" max="359" step="1" value="0" aria-label={c.travel.phaseAria} />
    </label>
  </div>
  <ul class="siph-legend">
    <li><i class="swatch-te"></i> TE0 · neff 2.445</li>
    <li><i class="swatch-tm"></i> TM0 · neff 1.771</li>
  </ul>
  <div class="siph-widget__stage" data-stage>
    <canvas data-canvas aria-hidden="true"></canvas>
  </div>
  <p class="siph-widget__live" data-live aria-live="polite"></p>
  <p class="siph-widget__credit">Fierceman · fierceman26.github.io</p>
  <figcaption>
    {c.travel.caption}
  </figcaption>
</figure>

<script>
  import { mountTravel } from './travel-view';

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-siph="travel"]').forEach((el) => mountTravel(el));
  }

  boot();
</script>
