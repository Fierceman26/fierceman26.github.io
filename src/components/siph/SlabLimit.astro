---
import '~/styles/siph-widgets.css';
import { siphCopy } from './copy';
import { useLocale } from '~/i18n/routing';

const c = siphCopy(useLocale(Astro.currentLocale, Astro.url.pathname));
---

<figure class="siph-widget" data-siph="slab">
  <div class="siph-widget__accent" aria-hidden="true"></div>
  <div class="siph-widget__head">
    <p class="siph-widget__kicker">{c.schematic}</p>
    <p class="siph-widget__title">{c.slab.title}</p>
  </div>
  <div class="siph-widget__controls">
    <button class="siph-widget__play" type="button" data-play aria-pressed="false">{c.play}</button>
    <label class="siph-widget__slider">
      <span>{c.slab.thickness}</span>
      <input type="range" data-thick min="0" max="1000" step="1" value="0" aria-valuemin="0" aria-valuemax="1000" />
    </label>
  </div>
  <div class="siph-widget__stage" data-stage>
    <canvas data-canvas aria-hidden="true"></canvas>
  </div>
  <p class="siph-widget__live" data-live aria-live="polite"></p>
  <p class="siph-widget__credit">Fierceman · fierceman26.github.io</p>
  <figcaption>
    {c.slab.caption}
  </figcaption>
</figure>

<script>
  import { mountSlab } from './slab-view';

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-siph="slab"]').forEach((el) => mountSlab(el));
  }

  boot();
</script>
