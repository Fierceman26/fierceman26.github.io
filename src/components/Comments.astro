---
// 匿名留言 —— 访客不需要任何账号。
// 提交经 FormSubmit 转发到 SITE.email（对外专用邮箱，非个人邮箱）。
// 同时提供 mailto 作为备用通道。
import { SITE } from '~/consts';
import { useLocale } from '~/i18n/routing';
import { useUI } from '~/i18n/ui';

const locale = useLocale(Astro.currentLocale, Astro.url.pathname);
const c = useUI(locale).comments;
const endpoint = `https://formsubmit.co/ajax/${SITE.email}`;
const subjectTemplate = locale === 'zh'
  ? '[FIERCEMAN · JOURNAL] 留言来自 {name}'
  : '[FIERCEMAN · JOURNAL] Note from {name}';
const copy = {
  errName: c.errName,
  errShort: c.errShort,
  ok: c.ok,
  errActivation: c.errActivation,
  errSend: c.errSend,
  errNet: c.errNet,
  sending: c.sending,
};
---

<section class="comments" id="comments" aria-label={c.aria}>
  <div class="comments__head">
    <span class="comments__label">{c.label}</span>
    <span class="comments__line" aria-hidden="true"></span>
  </div>

  <p class="comments__note">
    {c.note}
  </p>

  <form class="reply-form" id="reply-form" novalidate>
    <div class="reply-form__grid">
      <label class="reply-form__field">
        <span class="reply-form__label">{c.name}</span>
        <input
          class="reply-form__input"
          type="text"
          name="name"
          maxlength="40"
          required
          autocomplete="nickname"
          placeholder={c.namePh}
        />
      </label>
      <label class="reply-form__field">
        <span class="reply-form__label">
          {c.reply}<span class="reply-form__opt">{c.replyOpt}</span>
        </span>
        <input
          class="reply-form__input"
          type="email"
          name="reply"
          maxlength="120"
          autocomplete="email"
          placeholder="you@example.com"
        />
      </label>
    </div>

    <label class="reply-form__field">
      <span class="reply-form__label">{c.message}</span>
      <textarea
        class="reply-form__input reply-form__textarea"
        name="message"
        rows="5"
        maxlength="2000"
        required
        placeholder={c.messagePh}
      ></textarea>
    </label>

    <!-- 反垃圾：正常人看不到这个字段 -->
    <input
      type="text"
      name="_honey"
      tabindex="-1"
      autocomplete="off"
      class="reply-form__honey"
      aria-hidden="true"
    />

    <div class="reply-form__actions">
      <button class="reply-form__submit" type="submit">{c.send}</button>
      <p class="reply-form__status" id="reply-form-status" role="status" aria-live="polite"></p>
    </div>
  </form>

  <p class="comments__alt">
    {c.altBefore} <a href={`mailto:${SITE.email}`}>{c.altLink}</a>{c.altAfter}
  </p>
</section>

<script is:inline define:vars={{ endpoint, copy, subjectTemplate }}>
  (() => {
    const form = document.getElementById('reply-form');
    const status = document.getElementById('reply-form-status');
    if (!form || !status) return;

    const setStatus = (msg, kind) => {
      status.textContent = msg;
      status.dataset.kind = kind || '';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.dataset.busy === '1') return;

      const name = form.name.value.trim();
      const message = form.message.value.trim();
      const reply = form.reply.value.trim();

      if (!name) { setStatus(copy.errName, 'error'); form.name.focus(); return; }
      if (message.length < 4) { setStatus(copy.errShort, 'error'); form.message.focus(); return; }

      form.dataset.busy = '1';
      const btn = form.querySelector('.reply-form__submit');
      const original = btn.textContent;
      btn.textContent = copy.sending;
      setStatus('', '');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name,
            reply,
            message,
            _subject: subjectTemplate.replace('{name}', name),
            _template: 'table',
            _captcha: 'false',
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (res.ok && (data.success === true || data.success === 'true')) {
          form.reset();
          setStatus(copy.ok, 'ok');
        } else {
          const msg = (data && data.message) || '';
          setStatus(msg.includes('Activation') ? copy.errActivation : copy.errSend, 'error');
        }
      } catch (err) {
        setStatus(copy.errNet, 'error');
      } finally {
        form.dataset.busy = '0';
        btn.textContent = original;
      }
    });
  })();
</script>

<style>
  .comments {
    margin-top: 3.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .comments__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .comments__label {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .comments__line {
    flex: 1;
    height: 1px;
    background: var(--rule-soft);
  }

  .comments__note,
  .comments__alt {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .comments__note {
    margin: 0 0 1.6rem;
  }

  .comments__alt {
    margin: 1.4rem 0 0;
  }

  .comments__alt a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-underline-offset: 3px;
  }

  .comments__alt a:hover {
    text-decoration-color: var(--accent);
  }

  /* ---------- 表单 ---------- */
  .reply-form {
    font-family: var(--font-sans);
    margin: 0;
  }

  .reply-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 560px) {
    .reply-form__grid {
      grid-template-columns: 1fr;
    }
  }

  .reply-form__field {
    display: block;
    margin-bottom: 1rem;
  }

  .reply-form__label {
    display: block;
    font-size: var(--fs-meta);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }

  .reply-form__opt {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.78rem;
    color: var(--faint);
  }

  .reply-form__input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.62rem 0.75rem;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .reply-form__input::placeholder {
    color: var(--faint);
  }

  .reply-form__input:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--bg);
  }

  .reply-form__textarea {
    resize: vertical;
    min-height: 7rem;
    line-height: 1.6;
  }

  .reply-form__honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .reply-form__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .reply-form__submit {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 2px;
    padding: 0.62rem 1.6rem;
    cursor: pointer;
    transition: opacity 0.2s var(--ease);
  }

  .reply-form__submit:hover {
    opacity: 0.86;
  }

  .reply-form__status {
    font-size: 0.84rem;
    margin: 0;
    color: var(--muted);
    min-height: 1.2em;
  }

  .reply-form__status[data-kind='ok'] {
    color: var(--accent);
  }

  .reply-form__status[data-kind='error'] {
    color: var(--accent-soft);
  }
</style>
