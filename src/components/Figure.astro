---
import { REPOST_MARK } from '~/lib/repost-mark.mjs';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  caption,
  credit,
  width,
  height,
} = Astro.props;
---

<figure class="figure">
  <div class="figure__frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading="lazy"
      decoding="async"
    />
    <span class="img-credit" aria-hidden="true">{REPOST_MARK}</span>
  </div>
  {/* 默认出处在图内角标上。再写一行同样的图下署名会和角标叠在一起，所以只在传入别的 credit 时保留。 */}
  {credit && <div class="figure__credit">{credit}</div>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.8rem 0 1.2rem;
  }

  .figure__frame {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
  }

  .figure__frame img {
    margin: 0;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  /* 只有传入额外 credit 时才出现。默认出处在图内角标，避免和说明叠成两行同样的字。 */
  .figure__credit {
    margin: 0.35rem 0 0;
    text-align: right;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    color: var(--muted);
  }

  .figure figcaption {
    margin: 0.35rem 0 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
