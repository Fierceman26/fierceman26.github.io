---
import { SITE } from '~/consts';
import { localizePath, useLocale } from '~/i18n/routing';
import { useUI } from '~/i18n/ui';

const locale = useLocale(Astro.currentLocale, Astro.url.pathname);
const t = useUI(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__row">
      <div class="site-footer__brand">
        {SITE.shortTitle}
        <span>JOURNAL · {year}</span>
      </div>
      <nav class="site-footer__meta" aria-label={t.footerAria}>
        <a href={localizePath('/rss.xml', locale)}>RSS</a>
        &nbsp;·&nbsp;
        <a href={`mailto:${SITE.email}`}>{t.contact}</a>
        &nbsp;·&nbsp;
        <a href={localizePath('/about/', locale)}>{t.colophon}</a>
      </nav>
    </div>
    <p class="site-footer__colophon">
      {t.typeset}
    </p>
    <p class="site-footer__rights">
      &copy; {year} {SITE.author}. {t.rights}
      <a href="/LICENSE">LICENSE</a>
    </p>
  </div>
</footer>
