---
import type { JournalPost } from '~/lib/posts';
import FormattedDate from './FormattedDate.astro';
import { findCategory } from '~/consts';
import { localizePath, useLocale } from '~/i18n/routing';
import { useUI } from '~/i18n/ui';

interface Props {
  post: JournalPost;
  index?: number;
  readingTime?: string;
}

const locale = useLocale(Astro.currentLocale, Astro.url.pathname);
const t = useUI(locale);
const { post, index, readingTime } = Astro.props;
const href = localizePath(`/posts/${post.id}/`, locale);
const numeralText = typeof index === 'number'
  ? String(index + 1).padStart(2, '0')
  : null;
const category = post.data.category ? findCategory(post.data.category) : null;
---

<article class="card">
  {numeralText && <div class="card__numeral" aria-hidden="true">№ {numeralText}</div>}

  <div class="card__meta">
    <FormattedDate date={post.data.pubDate} />
    {category && (
      <>
        <span class="dot" aria-hidden="true"></span>
        <a href={localizePath(`/categories/${category.slug}/`, locale)}>{category.title}</a>
      </>
    )}
    {readingTime && (
      <>
        <span class="dot" aria-hidden="true"></span>
        <span>{readingTime}</span>
      </>
    )}
  </div>

  <h3 class="card__title">
    <a href={href}>{post.data.title}</a>
  </h3>

  <p class="card__lead">{post.data.description}</p>

  <a href={href} class="card__footer">
    {t.post.readOn}<span aria-hidden="true">→</span>
  </a>
</article>
