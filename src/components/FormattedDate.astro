---
import { magazineDate } from '~/consts';

interface Props {
  date: Date | string;
  format?: 'magazine' | 'iso' | 'human';
}

const { date, format = 'magazine' } = Astro.props;
const d = typeof date === 'string' ? new Date(date) : date;

let display: string;
if (format === 'iso') {
  display = d.toISOString().slice(0, 10);
} else if (format === 'human') {
  display = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
} else {
  display = magazineDate(d);
}
---
<time datetime={d.toISOString()}>{display}</time>
