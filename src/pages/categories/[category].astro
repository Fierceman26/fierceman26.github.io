---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FormattedDate from '~/components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '~/consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);

  return CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: {
      category: cat,
      posts: allPosts
        .filter((p) => p.data.category === cat.slug)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { category, posts } = Astro.props as {
  category: (typeof CATEGORIES)[number];
  posts: Awaited<ReturnType<typeof getCollection<'posts'>>>;
};
---

<BaseLayout
  title={`${category.title} · ${category.subtitle}`}
  description={category.tagline}
>
  <section class="container hero">
    <div class="hero__masthead">
      <span>Section</span>
      <span style="color: var(--ink);">·</span>
      <span>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</span>
    </div>
    <h1 class="hero__title">
      {category.title} <em style="color: var(--accent);">·</em>
      <span style="font-style: italic; font-weight: 400; color: var(--ink-soft);">
        {category.subtitle}
      </span>
    </h1>
    <p class="hero__lead">{category.tagline}</p>
    <p class="hero__lead-zh">{category.taglineZh}</p>
    <div class="card__meta" style="margin-top: 1.5rem; gap: 0.5rem 0.9rem; flex-wrap: wrap;">
      {category.keywords.map((k) => <span>{k}</span>)}
    </div>
  </section>

  <section class="container archive">
    {posts.length > 0 ? (
      <ul class="archive__list">
        {posts.map((post) => (
          <li class="archive__item">
            <div class="archive__date">
              <FormattedDate date={post.data.pubDate} />
            </div>
            <a class="archive__title" href={`/posts/${post.id}/`}>
              {post.data.title}
            </a>
            <div class="archive__tags">
              {post.data.tags[0] ?? ''}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="meta" style="padding-block: 3rem; text-align: center;">
        Nothing under this section yet. Stay tuned —
        {' '}<a href="/" style="color: var(--accent);">back to home</a>.
      </p>
    )}
  </section>
</BaseLayout>
