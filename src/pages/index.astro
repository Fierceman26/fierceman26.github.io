---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FeaturedPost from '~/components/FeaturedPost.astro';
import PostCard from '~/components/PostCard.astro';
import { SITE, issueLabel, CATEGORIES } from '~/consts';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';

// 拿全部已发布文章，按时间倒序
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// featured: frontmatter 里 featured=true 的优先；没有则用最新一篇
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const restPosts = allPosts.filter((p) => p.id !== featured?.id);

// 估算 featured 的阅读时间
const featuredReadingTime = featured
  ? `${Math.max(1, Math.round(readingTime(featured.body ?? '').minutes))} min read`
  : undefined;

// 每个栏目的文章数 —— 用于首页栏目卡片
const sectionCounts = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.category) {
    sectionCounts.set(post.data.category, (sectionCounts.get(post.data.category) ?? 0) + 1);
  }
}

const issue = issueLabel(new Date());
---

<BaseLayout description={SITE.description}>
  <section class="container hero">
    <div class="hero__masthead">
      <span>{issue}</span>
      <span style="color: var(--ink);">·</span>
      <span>The Fierceman Journal</span>
    </div>
    <h1 class="hero__title">
      Notes on signal integrity,<br/>
      silicon photonics, and the<br/>
      <em>quiet details</em> of EDA.
    </h1>
    <p class="hero__lead">{SITE.tagline}</p>
    <p class="hero__lead-zh">{SITE.taglineZh}</p>
  </section>

  {featured && (
    <>
      <FeaturedPost post={featured} readingTime={featuredReadingTime} />
    </>
  )}

  <section class="container">
    <div class="section-label">
      <span>The Sections</span>
    </div>
    <div class="sections-grid">
      {CATEGORIES.map((cat, i) => {
        const n = sectionCounts.get(cat.slug) ?? 0;
        return (
          <a class="section-card" href={`/categories/${cat.slug}/`}>
            <div class="section-card__numeral" aria-hidden="true">
              S{String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="section-card__title">{cat.title}</h3>
            <div class="section-card__subtitle">{cat.subtitle}</div>
            <p class="section-card__tagline">{cat.tagline}</p>
            <div class="section-card__keywords">
              {cat.keywords.slice(0, 4).map((k) => <span>{k}</span>)}
            </div>
            <div class="section-card__footer">
              <span>{n} {n === 1 ? 'entry' : 'entries'}</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  {restPosts.length > 0 && (
    <section class="container">
      <div class="section-label">
        <span>Recent Writing</span>
      </div>
      <div class="grid">
        {restPosts.slice(0, 9).map((post, i) => (
          <PostCard post={post} index={i} />
        ))}
      </div>
      {restPosts.length > 9 && (
        <p style="text-align: center; margin-top: 3rem;">
          <a href="/posts/" class="card__footer" style="display: inline-block;">
            Browse the full archive<span aria-hidden="true">→</span>
          </a>
        </p>
      )}
    </section>
  )}

  {allPosts.length === 0 && (
    <section class="container" style="padding-block: 4rem; text-align: center;">
      <p class="meta">No entries yet. Stay tuned.</p>
    </section>
  )}
</BaseLayout>
