---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugifyTag } from '~/consts';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}

const tags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="按标签浏览全部文章。">
  <section class="container hero">
    <div class="hero__masthead">
      <span>Topics</span>
      <span style="color: var(--ink);">·</span>
      <span>{tags.length} tags</span>
    </div>
    <h1 class="hero__title" style="font-size: clamp(2.4rem, 5vw, 3.8rem);">
      Tags
    </h1>
    <p class="hero__lead">
      An informal taxonomy of recurring topics. Counts in superscript.
    </p>
  </section>

  <section class="container">
    <div class="tag-cloud">
      {tags.length === 0 && <p class="meta">No tags yet.</p>}
      {tags.map(([tag, count]) => (
        <a href={`/tags/${slugifyTag(tag)}/`}>
          {tag}<sup>{count}</sup>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
